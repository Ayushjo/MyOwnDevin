# LLM Providers (at least one required)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# GitHub (fallback token used when a task has no signed-in user)
GITHUB_TOKEN=

# GitHub OAuth app (https://github.com/settings/developers)
# Authorization callback URL must be: <BACKEND_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to encrypt session access tokens at rest (use a long random string)
SESSION_SECRET=

# Redis
# Local: redis://127.0.0.1:6379
# Railway (backend service): use REDIS_PRIVATE_URL or REDIS_URL from the Redis plugin (private network).
# Railway (local dev against cloud Redis): use REDIS_PUBLIC_URL only when running backend on your laptop.
REDIS_URL=redis://127.0.0.1:6379

# Server
PORT=3500
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3500

# Optional: legacy shared API token (kept for scripts/benchmarks)
API_TOKEN=

# Hybrid model routing — provider:model
# Planner/verifier: free Groq 8B (500k TPD) | Executor: OpenAI mini (reliable tools) | Replan: OpenAI nano
PLANNER_MODEL=groq:llama-3.1-8b-instant
EXECUTOR_MODEL=openai:gpt-4o-mini
VERIFIER_MODEL=groq:llama-3.1-8b-instant
REPLAN_MODEL=openai:gpt-4.1-nano
LLM_FAILOVER=groq,gemini,openrouter,openai
LLM_MAX_TOKENS=2048
LLM_FREE_TIER=false

# Budget caps (strict — see backend/.env comments)
TASK_BUDGET_USD=0.10
OPENAI_TASK_BUDGET_USD=0.08
ORG_BUDGET_USD=5.00
ORG_HARD_STOP_USD=4.75
MAX_SINGLE_CALL_USD=0.02
BUDGET_DOWNGRADE_PCT=0.5
MAX_LLM_CALLS_PER_TASK=35
MAX_OPENAI_CALLS_PER_TASK=40

# Agent context limits
AGENT_HISTORY_WINDOW=6
MAX_TOOL_RESULT_CHARS=8000
MAX_STEP_VERIFY_ATTEMPTS=5
AGENT_MAX_ITERATIONS=40
